{
  "prompt_template": null,
  "user_input": null,
  "llm": {
    "id": "ollama_llm",
    "models": [
      {
        "provider": "ollama",
        "model": "llama3.1:8b",
        "api_base": "http://localhost:11434",
        "temperature": 0.0,
        "max_tokens": 800,
        "api_key": "${OLLAMA_API_KEY}",
        "request_timeout": 120
      }
    ]
  },
  "flow_retrieval": {
    "embeddings": {
      "provider": "openai",
      "model": "text-embedding-3-large"
    },
    "num_flows": 20,
    "turns_to_embed": 1,
    "should_embed_slots": true,
    "active": false
  },
  "max_retries": 3,
  "retry_delay": 1.0
}